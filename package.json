{
  "name": "questrade-ts",
  "version": "1.0.0",
  "description": "Lightweight, zero-dependency TypeScript SDK for Questrade API with auto token refresh, rate-limit backoff, and dual WebSocket streaming & adaptive polling feeds.",
  "type": "module",
  "main": "./dist/sdk/index.cjs",
  "module": "./dist/sdk/index.js",
  "types": "./dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js",
      "require": "./dist/sdk/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/sdk",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "questrade",
    "questrade-api",
    "trading",
    "stocks",
    "tsx",
    "nasdaq",
    "websocket",
    "streaming",
    "market-data",
    "options",
    "typescript"
  ],
  "author": "Questrade TypeScript SDK Contributors",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build:sdk",
    "build:sdk": "esbuild src/sdk/index.ts --bundle --platform=neutral --format=esm --sourcemap --outfile=dist/sdk/index.js && esbuild src/sdk/index.ts --bundle --platform=neutral --format=cjs --sourcemap --outfile=dist/sdk/index.cjs && tsc -p tsconfig.sdk.json",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "example:auth": "tsx examples/01-basic-authentication.ts",
    "example:portfolio": "tsx examples/02-account-portfolio.ts",
    "example:quotes": "tsx examples/03-market-quotes-candles.ts",
    "example:stream": "tsx examples/04-websocket-streaming.ts",
    "example:poll": "tsx examples/05-batch-polling-feed.ts",
    "example:hybrid": "tsx examples/06-hybrid-market-feed.ts",
    "example:options": "tsx examples/07-options-chains.ts",
    "example:orders": "tsx examples/08-order-lifecycle.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
